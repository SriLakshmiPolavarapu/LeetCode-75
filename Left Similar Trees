/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean leafSimilar(TreeNode root1, TreeNode root2) {
        
        List<Integer> eq1 = new ArrayList<>();
        List<Integer> eq2 = new ArrayList<>();

        check(root1, eq1);
        check(root2, eq2);

        return eq1.equals(eq2);
    }

    private void check(TreeNode root, List<Integer> leaves)
    {
        if(root == null)
            return;
        if(root.left == null && root.right == null)
        {
            leaves.add(root.val);
            return;
        }
        check(root.left, leaves);
        check(root.right, leaves);
    }
}
