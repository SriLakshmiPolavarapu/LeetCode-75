/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int goodNodes(TreeNode root) {
        return check(root, Integer.MIN_VALUE);
    }

    private int check(TreeNode root, int maxVal)
    {
        if(root == null)
            return 0;
        
        int count = (root.val >= maxVal) ? 1 : 0;
        int newMax = Math.max(root.val, maxVal);
        return count + check(root.left, newMax) + check(root.right, newMax); 
    }
}
