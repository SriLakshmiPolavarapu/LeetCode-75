class Solution {
    public int longestSubarray(int[] nums) {
        int max_ones = 0;
        int left=0;
        int max_zeros=0;

        for(int right =0;right<nums.length;right++)
        {
            if(nums[right] == 0)
            {
                max_zeros++;
            }

            while(max_zeros > 1)
            {
                if(nums[left] == 0)
                {
                    max_zeros--;
                }
                left++;
            }
            max_ones = Math.max(max_ones, right - left);
        }
        return max_ones;
        
    }
}
