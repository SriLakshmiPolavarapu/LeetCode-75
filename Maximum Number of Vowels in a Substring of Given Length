##### NOT OPTIMAL SOLUTION

class Solution {
    public int maxVowels(String s, int k) {
        
        int maxCount = Integer.MIN_VALUE;

        for(int i=0;i<=s.length()-k;i++)
        {
            int count=0;
            for(int j=i;j<i+k;j++)
            {
                char ch = s.charAt(j);
                if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') 
                {
                    count++;
                }
            }
            maxCount = Math.max(maxCount, count);
        }
        return maxCount;
    }
}
